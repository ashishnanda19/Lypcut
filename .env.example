# Copy to .env for running the API and worker on your machine (npm run dev / npm run worker)
# against the Docker infrastructure:  docker compose up -d postgres redis minio createbuckets
# Inside Docker Compose these are set in docker-compose.yml, so no .env is needed there.

# ---- Process --------------------------------------------------------------------------------
NODE_ENV=development            # development | test | production
HOST=0.0.0.0                    # interface to bind
PORT=4000                       # API port
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
TRUST_PROXY=false               # true behind a load balancer, so req.ip is the real client
SHUTDOWN_TIMEOUT_MS=10000       # force-exit if graceful shutdown takes longer
TMP_DIR=                        # scratch space for video work; default is the OS temp dir
WORKER_HEALTH_PORT=4001         # the worker's /health and /ready port

# ---- HTTP -----------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173   # comma separated browser origins (the front end)
RATE_LIMIT_MAX=300                   # requests per window per IP
RATE_LIMIT_WINDOW_SEC=60

# ---- Postgres -------------------------------------------------------------------------------
DATABASE_URL=postgres://lypcut:lypcut@localhost:5433/lypcut
DATABASE_POOL_MAX=10

# ---- Redis (BullMQ queues and rate limiting) ------------------------------------------------
REDIS_URL=redis://localhost:6380

# ---- Object storage (MinIO locally, AWS S3 in production) -----------------------------------
S3_ENDPOINT=http://localhost:9000    # leave empty for AWS S3
S3_PUBLIC_ENDPOINT=                  # only if the browser must reach storage at a different host
S3_REGION=us-east-1
S3_BUCKET=lypcut
S3_ACCESS_KEY_ID=lypcut              # leave both empty on AWS to use the task role
S3_SECRET_ACCESS_KEY=lypcut-local-secret
S3_FORCE_PATH_STYLE=true             # true for MinIO, false for AWS
CDN_BASE_URL=                        # CloudFront base URL later; empty means presigned S3 URLs
