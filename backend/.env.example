# Copy to .env for running the API and worker on your machine (npm run dev / npm run worker)
# against the Docker infrastructure:  docker compose up -d postgres redis minio createbuckets
# Inside Docker Compose these are set in docker-compose.yml, so no .env is needed there.

# ---- Process --------------------------------------------------------------------------------
NODE_ENV=development            # development | test | production
HOST=0.0.0.0                    # interface to bind
PORT=4000                       # API port
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
TRUST_PROXY=false               # true behind a load balancer, so req.ip is the real client
SHUTDOWN_TIMEOUT_MS=10000       # force-exit if graceful shutdown takes longer
TMP_DIR=                        # scratch space for video work; default is the OS temp dir
WORKER_HEALTH_PORT=4001         # the worker's /health and /ready port
WORKER_CONCURRENCY=2            # jobs a worker runs at once per queue

# ---- HTTP -----------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173   # comma separated browser origins (the front end)
RATE_LIMIT_MAX=300                   # requests per window per IP
RATE_LIMIT_WINDOW_SEC=60

# ---- Auth -----------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48   (never reuse this local-development value)
AUTH_ACCESS_SECRET=local-development-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SEC=900             # access token lifetime (15 minutes)
REFRESH_TOKEN_TTL_SEC=2592000        # refresh token lifetime (30 days)
REFRESH_REUSE_GRACE_SEC=10           # tolerate a refresh race between two tabs for this long
COOKIE_SECURE=                       # empty = true in production, false otherwise
COOKIE_DOMAIN=                       # empty = host-only cookies
AUTH_RATE_LIMIT_MAX=10               # signup/login/refresh requests per IP per window
LOGIN_MAX_FAILURES=5                 # failed logins per account before a lockout
LOGIN_LOCK_SEC=900                   # lockout length (15 minutes)

# ---- Uploads and media ----------------------------------------------------------------------
MAX_UPLOAD_BYTES=8589934592          # largest accepted file (8 GiB)
UPLOAD_PART_SIZE_MB=16               # multipart part size; S3 minimum is 5
UPLOAD_TTL_HOURS=24                  # how long an unfinished upload can be resumed
PRESIGN_GET_TTL_SEC=3600             # lifetime of download URLs
PRESIGN_PUT_TTL_SEC=3600             # lifetime of upload-part URLs
FFPROBE_BIN=ffprobe
FFMPEG_BIN=ffmpeg

# ---- Transcription ---------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER=whisper-local # whisper-local | openai | assemblyai
WHISPER_BIN=whisper-cli              # whisper.cpp binary (whisper-local only)
WHISPER_MODEL_PATH=./models/ggml-small.bin   # download with: npm run models:download
WHISPER_THREADS=4
WHISPER_PROMPT=                      # optional priming text, e.g. a line of Hinglish
OPENAI_API_KEY=                      # required when TRANSCRIPTION_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=whisper-1
ASSEMBLYAI_API_KEY=                  # required when TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com

# ---- Processing -----------------------------------------------------------------------------
JOB_ATTEMPTS=5                       # tries before a job is marked failed and kept as a dead letter
JOB_BACKOFF_MS=2000                  # first retry wait; doubles each time
PROCESSING_CONCURRENCY=1             # processing jobs at once per worker (video work is heavy)
SCENE_THRESHOLD=0.3                  # picture-change score (0-1) that counts as a cut; lower finds more
MIN_SCENE_SEC=1.5                    # shorter scenes are folded into their neighbour
MAX_SCENE_SEC=60                     # longer unbroken shots are split at this length

# ---- Live job feed (WebSocket) ----------------------------------------------------------------
JOBS_WS_REFRESH_MS=3000              # re-read watched unfinished jobs this often, in case a message was missed
JOBS_WS_PING_MS=30000                # ping clients this often and drop dead connections

# ---- Language model (assistant, highlights, chapters) -----------------------------------------
# Instagram tokens (Style feature) are sealed at rest with AES-256-GCM. Development and tests use a built-in public key, so
# leave these empty locally. Production refuses to start without a real key: echo "k1:$(openssl rand -base64 32)"
# To rotate: put the new key (new id) in TOKEN_ENCRYPTION_KEY and the previous one in TOKEN_ENCRYPTION_OLD_KEYS (comma separated).
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_OLD_KEYS=

# Leave ANTHROPIC_API_KEY empty and everything runs on the built-in offline model: no account, no cost.
LLM_PROVIDER=auto                    # auto (Claude if a key is set) | anthropic | fake
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
LLM_MODEL_PLANNER=claude-sonnet-5-5  # chat planning
LLM_MODEL_BATCH=claude-haiku-5-5     # highlights and chapters (bulk work: the cheaper model)
LLM_EFFORT_PLANNER=low               # low | medium | high. Claude's newer models take no temperature, so effort is the lever
LLM_EFFORT_BATCH=low
LLM_STRICT_TOOLS=false               # ask the API to guarantee tool arguments; every call is validated here regardless
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2                    # after a timeout, rate limit or server error, with jittered backoff
LLM_RETRY_BASE_MS=500
LLM_MAX_INPUT_TOKENS=60000           # a request estimated above this is refused before it is sent
LLM_MAX_OUTPUT_TOKENS_PLANNER=2000
LLM_MAX_OUTPUT_TOKENS_BATCH=6000
LLM_MONTHLY_BUDGET_USD=0             # global ceiling per calendar month (UTC); at the ceiling the offline model takes over. 0 = none
LLM_BREAKER_FAILURES=5               # provider failures in a row before the offline model takes over...
LLM_BREAKER_COOLDOWN_SEC=60          # ...for this long
STYLE_CONCURRENCY=1                  # style analysis jobs at once; kept low so learning a style never slows an edit
PLANNER_DAILY_LIMIT=30               # assistant requests per user per day
PLANNER_BURST_PER_MINUTE=10

# ---- Postgres -------------------------------------------------------------------------------
DATABASE_URL=postgres://lypcut:lypcut@localhost:5433/lypcut
DATABASE_POOL_MAX=10

# ---- Redis (BullMQ queues and rate limiting) ------------------------------------------------
REDIS_URL=redis://localhost:6380

# ---- Object storage (MinIO locally, AWS S3 in production) -----------------------------------
S3_ENDPOINT=http://localhost:9000    # leave empty for AWS S3
S3_PUBLIC_ENDPOINT=                  # only if the browser must reach storage at a different host
S3_REGION=us-east-1
S3_BUCKET=lypcut
S3_ACCESS_KEY_ID=lypcut              # leave both empty on AWS to use the task role
S3_SECRET_ACCESS_KEY=lypcut-local-secret
S3_FORCE_PATH_STYLE=true             # true for MinIO, false for AWS
CDN_BASE_URL=                        # CloudFront base URL later; empty means presigned S3 URLs
